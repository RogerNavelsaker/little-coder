{
  "name": "little-coder",
  "version": "1.8.1",
  "description": "A pi-based coding agent optimized for small local language models. Reproduces the whitepaper's scaffold-model-fit adaptations as pi extensions.",
  "homepage": "https://github.com/RogerNavelsaker/little-coder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RogerNavelsaker/little-coder.git"
  },
  "license": "Apache-2.0",
  "author": "Roger Navelsaker",
  "type": "module",
  "bin": {
    "little-coder": "bin/little-coder.ts"
  },
  "files": [
    "bin/",
    "scripts/",
    "AGENTS.md",
    "skills/",
    ".pi/extensions/",
    ".pi/settings.json",
    "vendor/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "pi": "pi",
    "dev": "bun bin/little-coder.ts",
    "test": "find .pi scripts -name '*.test.ts' -exec bun test {} +",
    "test:coverage": "bun test .pi/extensions/**/*.test.ts --coverage --coverage-dir=coverage",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --bytecode --minify --format=esm bin/little-coder.ts --outfile dist/little-coder",
    "build:release": "bun scripts/build-release.ts",
    "postinstall": "bun scripts/patch-pi.ts",
    "check:tool-contracts": "bun run scripts/check-tool-contracts.ts",
    "check:clean": "bun run scripts/check-repo-cleanliness.ts",
    "check:ci-parity": "bun run scripts/check-ci-parity.ts",
    "check:debt": "bun run scripts/check-debt-markers.ts",
    "check:coverage": "bun run scripts/check-coverage.ts",
    "report:metrics": "bun run scripts/report-quality-metrics.ts",
    "check:precommit": "bun run check:clean && bun run typecheck && bun run check:tool-contracts && bun run check:debt",
    "check:prepush": "bun install --frozen-lockfile && bun run verify:ci",
    "check:all": "bun run check:clean && bun run typecheck && bun run check:tool-contracts && bun run check:debt && bun run test && bun run check:ci-parity",
    "verify:ci": "bun run build && bun run check:all && git diff --exit-code"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.3",
    "@sinclair/typebox": "^0.34.49",
    "@toon-format/toon": "^2.3.0",
    "bun-types": "^1.3.0",
    "typescript": "^5.6.0"
  }
}