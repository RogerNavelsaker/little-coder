{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun-types"]
  },
  "include": ["bin/**/*.ts", ".pi/extensions/**/*.ts"],
  "exclude": [
    ".pi/extensions/**/*.test.ts",
    ".pi/extensions/**/test-helpers.ts",
    ".pi/extensions/**/invoke.ts"
  ]
}
